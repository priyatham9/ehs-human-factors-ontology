    {
      "@id": "ehs:MentalFatigue",
      "@type": [
        "skos:Concept"
      ],
      "skos:broadMatch": [
        {
          "@id": "xw:sparh-FitnessForDuty"
        }
      ],
      "skos:broader": [
        {
          "@id": "ehs:TaskContext"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "xw:hfacs-AdverseMentalStates"
        },
        {
          "@id": "xw:hse-Fatigue"
        }
      ],
      "skos:inScheme": [
        {
          "@id": "ehs:PIFConceptScheme"
        }
      ],
      "skos:note": [
        {
          "@value": "Time-on-shift is the natural proxy here, and it is also where this ontology's claims stop: hour-of-shift injury counts are not risk rates without an exposure denominator (Hanecke et al. 1998; Folkard and Tucker 2003).",
          "@language": "en"
        }
      ],
      "skos:prefLabel": [
        {
          "@value": "Mental fatigue",
          "@language": "en"
        }
      ],
      "skos:relatedMatch": [
        {
          "@id": "xw:cream-TimeOfDay"
        },
        {
          "@id": "xw:hfacs-AdversePhysiologicalStates"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "IDHEAS-G files mental fatigue under Task. An occupational-safety practitioner would ordinarily file it under Human or Operational. The disagreement is recorded rather than resolved.",
          "@language": "en"
        }
      ]
    },
