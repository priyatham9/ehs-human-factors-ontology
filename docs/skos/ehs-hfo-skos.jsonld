      "skos:note": [
        {
          "@value": "Label identical to the IDHEAS-G category.",
          "@language": "en"
        }
      ],
      "skos:prefLabel": [
        {
          "@value": "System context",
          "@language": "en"
        }
      ],
      "skos:topConceptOf": [
        {
          "@id": "ehs:PIFConceptScheme"
        }
      ]
    },
    {
      "@id": "ehs:SystemTransparency",
      "@type": [
        "skos:Concept"
      ],
      "skos:altLabel": [
        {
          "@value": "System and I&C transparency to personnel",
          "@language": "en"
        }
      ],
      "skos:broadMatch": [
        {
          "@id": "xw:cream-AdequacyOfMMI"
        },
        {
          "@id": "xw:hfacs-TechnologicalEnvironment"
        },
        {
          "@id": "xw:sparh-ErgonomicsHMI"
        }
      ],
      "skos:broader": [
        {
          "@id": "ehs:SystemContext"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "xw:hse-ClarityOfSignsSignals"
        }
      ],
      "skos:inScheme": [
        {
          "@id": "ehs:PIFConceptScheme"
        }
      ],
      "skos:note": [
        {
          "@value": "The link to knowledge-based mistakes is interpretive: an opaque system denies the operator the mental model that knowledge-based reasoning requires (Rasmussen 1983).",
          "@language": "en"
        }
      ],
      "skos:prefLabel": [
        {
          "@value": "System transparency to personnel",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "ehs:TaskComplexity",
      "@type": [
        "skos:Concept"
      ],
      "skos:broader": [
        {
          "@id": "ehs:TaskContext"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "xw:hse-DifficultyComplexityOfTask"
        },
        {
          "@id": "xw:sparh-Complexity"
        }
      ],
      "skos:inScheme": [
        {
          "@id": "ehs:PIFConceptScheme"
        }
      ],
      "skos:note": [
        {
          "@value": "Interpretive. SPAR-H treats complexity as difficulty of performance; the step from difficulty to knowledge-based demand is this ontology's reading, not a finding.",
          "@language": "en"
        }
      ],
      "skos:prefLabel": [
        {
          "@value": "Task complexity",
          "@language": "en"
        }
      ],
