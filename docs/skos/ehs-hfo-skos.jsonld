    {
      "@id": "xw:fw-CREAM",
      "dcterms:bibliographicCitation": [
        {
          "@value": "Hollnagel, E. (1998). Cognitive Reliability and Error Analysis Method (CREAM). Oxford: Elsevier Science."
        }
      ],
      "dcterms:title": [
