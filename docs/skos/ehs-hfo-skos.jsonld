          "@id": "xw:hse-PreparationForTask"
        }
      ],
      "skos:scopeNote": [
        {
          "@value": "IDHEAS-G files procedures under Personnel. Practitioners frequently file them under Task or System. The disagreement is recorded rather than resolved.",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "ehs:ResistanceToPhysicalMovement",
      "@type": [
        "skos:Concept"
      ],
      "skos:broadMatch": [
        {
          "@id": "xw:cream-WorkingConditions"
        },
        {
          "@id": "xw:hfacs-PhysicalEnvironment"
