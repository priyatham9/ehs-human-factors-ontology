    {
      "@id": "ehs:PIFConceptScheme",
      "dcterms:creator": [
        {
          "@value": "Priyatham Chimmani"
        }
      ],
      "dcterms:description": [
        {
          "@value": "SKOS rendering of the four context dimensions and twenty performance-influencing factors of IDHEAS-G (NUREG-2198), with analyst-judged mappings to SPAR-H, CREAM, HFACS and the HSE PIF list. Generated from ontology/ehs-hfo.ttl. Not endorsed by any standards body.",
          "@language": "en"
        }
      ],
      "dcterms:hasVersion": [
        {
          "@value": "0.1.0"
        }
      ],
      "dcterms:license": [
        {
          "@id": "https://opensource.org/licenses/MIT"
        }
      ],
      "dcterms:source": [
        {
          "@id": "https://raw.githubusercontent.com/priyatham9/ehs-human-factors-ontology/main/ontology/ehs-hfo.ttl"
        }
      ],
      "dcterms:title": [
        {
          "@value": "EHS Human Factors Ontology: performance-influencing factors",
          "@language": "en"
        }
      ],
      "@type": [
        "skos:ConceptScheme"
      ],
      "skos:hasTopConcept": [
        {
          "@id": "ehs:HumanContext"
        },
        {
          "@id": "ehs:OperationalContext"
        },
        {
          "@id": "ehs:SystemContext"
        },
        {
          "@id": "ehs:TaskContext"
        }
      ]
    },
