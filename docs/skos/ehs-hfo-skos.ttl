ehs:TimePressureAndStress
    a skos:Concept ;
    skos:broader ehs:TaskContext ;
    skos:closeMatch xw:cream-AvailableTime ;
    skos:closeMatch xw:hse-StressMorale ;
    skos:closeMatch xw:hse-TimeAvailableRequired ;
    skos:closeMatch xw:sparh-AvailableTime ;
    skos:closeMatch xw:sparh-StressAndStressors ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Time pressure and stress"@en ;
    skos:relatedMatch xw:hfacs-AdverseMentalStates ;
    skos:relatedMatch xw:hse-WorkPressures ;
    skos:scopeNote "IDHEAS-G files time pressure and stress under Task. SPAR-H splits the same content across two separate PSFs (available time; stress and stressors)."@en .

ehs:Training
    a skos:Concept ;
