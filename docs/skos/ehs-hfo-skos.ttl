# ehs-hfo-skos.ttl -- SKOS rendering of the EHS-HFO PIF structure and crosswalk.
# GENERATED by tools/build_skos.py from ontology/ehs-hfo.ttl. Do not edit by hand.
# Mapping direction: from a PIF (subject) to the external factor (object).
# Licence: MIT. Not endorsed by any standards body.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ehs: <https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xw: <https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#> .

ehs:EquipmentAndTools
    a skos:Concept ;
    skos:broadMatch xw:hfacs-TechnologicalEnvironment ;
    skos:broader ehs:SystemContext ;
    skos:closeMatch xw:hse-ToolsAppropriateForTask ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Equipment and tools"@en ;
    skos:relatedMatch xw:cream-AdequacyOfMMI ;
    skos:relatedMatch xw:sparh-ErgonomicsHMI .

ehs:HumanContext
    a skos:Concept ;
    skos:closeMatch xw:idheas-Personnel ;
    skos:definition "Attributes of the people, teams and organisational processes performing the work."@en ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:narrower ehs:ProceduresGuidanceAndInstructions ;
    skos:narrower ehs:Staffing ;
    skos:narrower ehs:TeamAndOrganizationFactors ;
    skos:narrower ehs:Training ;
    skos:narrower ehs:WorkProcesses ;
    skos:note "Synonym for the IDHEAS-G category 'Personnel'."@en ;
    skos:prefLabel "Human context"@en ;
    skos:topConceptOf ehs:PIFConceptScheme .

ehs:HumanSystemInterface
    a skos:Concept ;
    skos:altLabel "HSI"@en ;
    skos:broader ehs:SystemContext ;
    skos:closeMatch xw:cream-AdequacyOfMMI ;
    skos:closeMatch xw:hfacs-TechnologicalEnvironment ;
    skos:closeMatch xw:hse-SystemEquipmentInterface ;
    skos:closeMatch xw:sparh-ErgonomicsHMI ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Human-system interface"@en .

ehs:InformationAvailabilityAndReliability
    a skos:Concept ;
    skos:broader ehs:TaskContext ;
    skos:closeMatch xw:hse-ClarityOfSignsSignals ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Information availability and reliability"@en ;
    skos:relatedMatch xw:cream-AdequacyOfMMI ;
    skos:relatedMatch xw:hfacs-TechnologicalEnvironment ;
    skos:relatedMatch xw:sparh-ErgonomicsHMI .

ehs:MentalFatigue
    a skos:Concept ;
    skos:broadMatch xw:sparh-FitnessForDuty ;
    skos:broader ehs:TaskContext ;
    skos:closeMatch xw:hfacs-AdverseMentalStates ;
    skos:closeMatch xw:hse-Fatigue ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:note "Time-on-shift is the natural proxy here, and it is also where this ontology's claims stop: hour-of-shift injury counts are not risk rates without an exposure denominator (Hanecke et al. 1998; Folkard and Tucker 2003)."@en ;
    skos:prefLabel "Mental fatigue"@en ;
    skos:relatedMatch xw:cream-TimeOfDay ;
    skos:relatedMatch xw:hfacs-AdversePhysiologicalStates ;
    skos:scopeNote "IDHEAS-G files mental fatigue under Task. An occupational-safety practitioner would ordinarily file it under Human or Operational. The disagreement is recorded rather than resolved."@en .

ehs:MultitaskingInterruptionsAndDistractions
    a skos:Concept ;
    skos:altLabel "Multitasking, interruptions, and distractions"@en ;
    skos:broader ehs:TaskContext ;
    skos:closeMatch xw:cream-NumberOfSimultaneousGoals ;
    skos:closeMatch xw:hse-DividedAttention ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Multitasking, interruptions and distractions"@en ;
    skos:relatedMatch xw:hfacs-AdverseMentalStates ;
    skos:relatedMatch xw:sparh-Complexity .

ehs:NoiseAndCommunicationPathways
    a skos:Concept ;
    skos:altLabel "Noise in workplace and communication pathways"@en ;
    skos:broadMatch xw:cream-WorkingConditions ;
    skos:broadMatch xw:hfacs-PhysicalEnvironment ;
    skos:broadMatch xw:hse-WorkingEnvironment ;
    skos:broader ehs:OperationalContext ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Noise and communication pathways"@en ;
    skos:relatedMatch xw:cream-CrewCollaborationQuality ;
    skos:relatedMatch xw:hse-CommunicationJob .

ehs:OperationalContext
    a skos:Concept ;
    skos:closeMatch xw:idheas-EnvironmentAndSituation ;
    skos:definition "Physical conditions of the place where the work occurs."@en ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:narrower ehs:NoiseAndCommunicationPathways ;
    skos:narrower ehs:ResistanceToPhysicalMovement ;
    skos:narrower ehs:ThermalConditions ;
    skos:narrower ehs:WorkplaceAccessibilityAndHabitability ;
    skos:narrower ehs:WorkplaceVisibility ;
    skos:note "Synonym for the IDHEAS-G category 'Environment and situation'. The rename buys familiarity for an occupational-safety audience and nothing else."@en ;
    skos:prefLabel "Operational context"@en ;
    skos:topConceptOf ehs:PIFConceptScheme .

ehs:PIFConceptScheme
    a skos:ConceptScheme ;
    dcterms:creator "Priyatham Chimmani" ;
    dcterms:description "SKOS rendering of the four context dimensions and twenty performance-influencing factors of IDHEAS-G (NUREG-2198), with analyst-judged mappings to SPAR-H, CREAM, HFACS and the HSE PIF list. Generated from ontology/ehs-hfo.ttl. Not endorsed by any standards body."@en ;
    dcterms:hasVersion "0.1.0" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://raw.githubusercontent.com/priyatham9/ehs-human-factors-ontology/main/ontology/ehs-hfo.ttl> ;
    dcterms:title "EHS Human Factors Ontology: performance-influencing factors"@en ;
    skos:hasTopConcept ehs:HumanContext ;
    skos:hasTopConcept ehs:OperationalContext ;
    skos:hasTopConcept ehs:SystemContext ;
    skos:hasTopConcept ehs:TaskContext .

ehs:PhysicalDemands
    a skos:Concept ;
    skos:broader ehs:TaskContext ;
    skos:closeMatch xw:hfacs-PhysicalMentalLimitations ;
    skos:closeMatch xw:hse-PhysicalCapability ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Physical demands"@en ;
    skos:relatedMatch xw:cream-WorkingConditions ;
    skos:relatedMatch xw:hfacs-AdversePhysiologicalStates ;
    skos:relatedMatch xw:hse-WorkOverloadUnderload ;
    skos:relatedMatch xw:sparh-FitnessForDuty .

ehs:ProceduresGuidanceAndInstructions
    a skos:Concept ;
    skos:altLabel "Procedures, guidance, and instructions"@en ;
    skos:broadMatch xw:hfacs-OperationalProcess ;
    skos:broader ehs:HumanContext ;
    skos:closeMatch xw:cream-AvailabilityOfProcedures ;
    skos:closeMatch xw:hse-ProceduresInadequate ;
    skos:closeMatch xw:sparh-Procedures ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Procedures, guidance and instructions"@en ;
    skos:relatedMatch xw:hse-PreparationForTask ;
    skos:scopeNote "IDHEAS-G files procedures under Personnel. Practitioners frequently file them under Task or System. The disagreement is recorded rather than resolved."@en .

ehs:ResistanceToPhysicalMovement
    a skos:Concept ;
    skos:broadMatch xw:cream-WorkingConditions ;
    skos:broadMatch xw:hfacs-PhysicalEnvironment ;
    skos:broadMatch xw:hse-WorkingEnvironment ;
    skos:broader ehs:OperationalContext ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Resistance to physical movement"@en .

ehs:ScenarioFamiliarity
    a skos:Concept ;
    skos:broader ehs:TaskContext ;
    skos:closeMatch xw:hse-RoutineOrUnusual ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:note "The demand claim is Rasmussen's: an unfamiliar situation for which no rule is stored must be handled at the knowledge-based level."@en ;
    skos:prefLabel "Scenario familiarity"@en ;
    skos:relatedMatch xw:cream-AdequacyOfTrainingAndExperience ;
    skos:relatedMatch xw:sparh-ExperienceAndTraining .

ehs:Staffing
    a skos:Concept ;
    skos:broadMatch xw:cream-AdequacyOfOrganisation ;
    skos:broader ehs:HumanContext ;
    skos:closeMatch xw:hfacs-ResourceManagement ;
    skos:closeMatch xw:hse-ManningLevels ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:prefLabel "Staffing"@en ;
    skos:relatedMatch xw:sparh-WorkProcesses .

ehs:SystemContext
    a skos:Concept ;
    skos:closeMatch xw:idheas-System ;
    skos:definition "Attributes of the plant, equipment, tools and interfaces the work is performed through."@en ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:narrower ehs:EquipmentAndTools ;
    skos:narrower ehs:HumanSystemInterface ;
    skos:narrower ehs:SystemTransparency ;
    skos:note "Label identical to the IDHEAS-G category."@en ;
    skos:prefLabel "System context"@en ;
    skos:topConceptOf ehs:PIFConceptScheme .

ehs:SystemTransparency
    a skos:Concept ;
    skos:altLabel "System and I&C transparency to personnel"@en ;
    skos:broadMatch xw:cream-AdequacyOfMMI ;
    skos:broadMatch xw:hfacs-TechnologicalEnvironment ;
    skos:broadMatch xw:sparh-ErgonomicsHMI ;
    skos:broader ehs:SystemContext ;
    skos:closeMatch xw:hse-ClarityOfSignsSignals ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:note "The link to knowledge-based mistakes is interpretive: an opaque system denies the operator the mental model that knowledge-based reasoning requires (Rasmussen 1983)."@en ;
    skos:prefLabel "System transparency to personnel"@en .

ehs:TaskComplexity
    a skos:Concept ;
    skos:broader ehs:TaskContext ;
    skos:closeMatch xw:hse-DifficultyComplexityOfTask ;
    skos:closeMatch xw:sparh-Complexity ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:note "Interpretive. SPAR-H treats complexity as difficulty of performance; the step from difficulty to knowledge-based demand is this ontology's reading, not a finding."@en ;
    skos:prefLabel "Task complexity"@en ;
    skos:relatedMatch xw:cream-NumberOfSimultaneousGoals ;
    skos:relatedMatch xw:hfacs-PlannedInappropriateOperations .

ehs:TaskContext
    a skos:Concept ;
    skos:closeMatch xw:idheas-Task ;
    skos:definition "Characteristics of the task being performed and of the information it requires."@en ;
    skos:inScheme ehs:PIFConceptScheme ;
    skos:narrower ehs:InformationAvailabilityAndReliability ;
    skos:narrower ehs:MentalFatigue ;
    skos:narrower ehs:MultitaskingInterruptionsAndDistractions ;
    skos:narrower ehs:PhysicalDemands ;
    skos:narrower ehs:ScenarioFamiliarity ;
    skos:narrower ehs:TaskComplexity ;
    skos:narrower ehs:TimePressureAndStress ;
    skos:note "Label identical to the IDHEAS-G category."@en ;
    skos:prefLabel "Task context"@en ;
    skos:topConceptOf ehs:PIFConceptScheme .

