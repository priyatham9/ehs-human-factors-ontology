    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#al-WP-sparh",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#Alignment"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "Identical label in both frameworks; IDHEAS-G took the term from SPAR-H.",
          "@language": "en"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#externalFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#sparh-WorkProcesses"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#hasMatchStrength": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#MatchClose"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#localFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#WorkProcesses"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#sourceRef": [
        {
          "@value": "gertman2005"
        }
      ]
    },
    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#gap-cream-TimeOfDay",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#CoverageGap"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "No local factor represents time of day or circadian phase. IDHEAS-G has no such\nPIF either, so the gap is inherited rather than introduced. This is the gap that\nmatters most for shift-based occupational settings, and closing it would require\nan exposure denominator by hour of shift that no public dataset currently\nsupplies (Hanecke et al. 1998; Folkard and Tucker 2003).",
          "@language": "en"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#sourceRef": [
        {
          "@value": "folkard2003"
        },
        {
          "@value": "hanecke1998"
        },
        {
          "@value": "hollnagel1998"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#uncoveredFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#cream-TimeOfDay"
        }
      ]
    },
    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#gap-hfacs-FailedToCorrectProblem",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#CoverageGap"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "No local factor represents a supervisor's failure to correct a known deficiency.",
          "@language": "en"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#sourceRef": [
        {
          "@value": "shappell2000"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#uncoveredFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#hfacs-FailedToCorrectProblem"
        }
      ]
    },
    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#gap-hfacs-PersonalReadiness",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#CoverageGap"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "No local factor represents personal readiness in the HFACS sense: an\nindividual's off-duty preparation for work, including rest, diet and compliance\nwith alcohol and self-medication rules. The gap is inherited rather than\nintroduced. IDHEAS-G has no fitness-for-duty PIF, whereas SPAR-H does, and the\ntwenty factors here are IDHEAS-G's twenty adopted unchanged. ehs:MentalFatigue\nis the nearest local factor and is deliberately not aligned to this one: fatigue\nis a state during the task, personal readiness is conduct before it, and one\ncauses the other rather than being it.",
          "@language": "en"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#sourceRef": [
        {
          "@value": "gertman2005"
        },
        {
          "@value": "nureg2198"
        },
        {
          "@value": "shappell2000"
        },
        {
          "@value": "shappell2006"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#uncoveredFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#hfacs-PersonalReadiness"
        }
      ]
    },
    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#gap-hfacs-SupervisoryViolations",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#CoverageGap"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "No local factor represents wilful supervisory disregard of rules.",
          "@language": "en"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#sourceRef": [
        {
          "@value": "shappell2000"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#uncoveredFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#hfacs-SupervisoryViolations"
        }
      ]
    },
    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#gap-hse-Motivation",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#CoverageGap"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "No local factor represents motivation or competing priorities as an attribute of the individual.",
          "@language": "en"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#sourceRef": [
        {
          "@value": "hse_pifs"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#uncoveredFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#hse-Motivation"
        }
      ]
    },
    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#gap-hse-OrganisationalLearning",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#CoverageGap"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "No local factor represents the effectiveness of organisational learning.",
          "@language": "en"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#sourceRef": [
        {
          "@value": "hse_pifs"
        }
      ],
      "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#uncoveredFactor": [
        {
          "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#hse-OrganisationalLearning"
        }
      ]
    },
    {
      "@id": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#gap-hse-PeerPressure",
      "@type": [
        "http://www.w3.org/2002/07/owl#NamedIndividual",
        "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#CoverageGap"
      ],
      "http://www.w3.org/2000/01/rdf-schema#comment": [
        {
          "@value": "No local factor represents peer pressure. Team and organisation factors is too coarse to stand in for it.",
          "@language": "en"
