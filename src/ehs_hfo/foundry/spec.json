  "action_types": [
    {
      "api_name": "flag_crosswalk_entry",
      "display_name": "Flag crosswalk entry for review",
      "description": "Mark an entry as under review. It stays traversable.",
      "parameters": [
        {
          "api_name": "entry",
          "type": "object_reference",
          "object_type": "CrosswalkEntry",
          "required": true
        },
        {
          "api_name": "reason",
          "type": "string",
          "required": true,
          "allowed_values": [
            "alignment_too_strong",
            "alignment_too_weak",
            "wrong_counterpart",
            "other"
          ]
        },
        {
          "api_name": "note",
          "type": "string",
          "required": false,
          "max_length": 500,
          "required_when": {
            "parameter": "reason",
            "equals": "other"
          }
        }
      ],
      "submission_criteria": [
        {
          "parameter": "entry",
          "property": "review_status",
          "operator": "not_equals",
          "value": "rejected",
          "failure_message": "Entry is already rejected."
        },
        {
          "parameter": "entry",
          "property": "review_status",
          "operator": "not_equals",
          "value": "under_review",
          "failure_message": "Entry is already under review."
        }
      ],
      "edits": [
        {
          "object_parameter": "entry",
          "set": {
            "review_status": "under_review",
            "review_reason": "$reason",
            "review_note": "$note"
          }
        }
      ]
    },
    {
      "api_name": "reject_crosswalk_entry",
      "display_name": "Reject crosswalk entry",
      "description": "Record that an entry is wrong. It leaves every traversal and coverage function.",
      "parameters": [
        {
          "api_name": "entry",
          "type": "object_reference",
          "object_type": "CrosswalkEntry",
          "required": true
        },
        {
          "api_name": "reason",
          "type": "string",
          "required": true,
          "allowed_values": [
            "alignment_too_strong",
            "alignment_too_weak",
            "wrong_counterpart",
            "other"
          ]
        },
        {
          "api_name": "note",
          "type": "string",
          "required": false,
          "max_length": 500,
          "required_when": {
            "parameter": "reason",
            "equals": "other"
          }
        }
      ],
      "submission_criteria": [
        {
          "parameter": "entry",
          "property": "review_status",
          "operator": "not_equals",
          "value": "rejected",
          "failure_message": "Entry is already rejected."
        }
      ],
      "edits": [
        {
          "object_parameter": "entry",
          "set": {
            "review_status": "rejected",
            "review_reason": "$reason",
            "review_note": "$note"
          }
        }
      ]
    },
    {
      "api_name": "reject_evidence_excerpt",
      "display_name": "Reject evidence excerpt",
      "description": "Record that a quoted passage does not support the PIF coded to it. The PIF link to the investigation is hidden.",
      "parameters": [
        {
          "api_name": "excerpt",
          "type": "object_reference",
          "object_type": "EvidenceExcerpt",
          "required": true
        },
        {
          "api_name": "reason",
          "type": "string",
          "required": true,
          "allowed_values": [
            "quote_not_in_source",
            "quote_does_not_state_factor",
            "other"
          ]
        },
        {
          "api_name": "note",
          "type": "string",
          "required": false,
          "max_length": 500,
          "required_when": {
            "parameter": "reason",
            "equals": "other"
          }
        }
      ],
      "submission_criteria": [
        {
          "parameter": "excerpt",
          "property": "review_status",
          "operator": "not_equals",
          "value": "rejected",
          "failure_message": "Excerpt is already rejected."
        }
      ],
      "edits": [
        {
          "object_parameter": "excerpt",
          "set": {
            "review_status": "rejected",
            "review_reason": "$reason",
            "review_note": "$note"
          }
        }
      ]
    },
    {
      "api_name": "retire_rule",
      "display_name": "Retire suggester rule",
      "description": "Take a phrase rule out of rules_triggered.",
      "parameters": [
        {
          "api_name": "rule",
          "type": "object_reference",
          "object_type": "Rule",
          "required": true
        },
        {
          "api_name": "reason",
          "type": "string",
          "required": true,
          "min_length": 10,
          "max_length": 500
        }
      ],
      "submission_criteria": [
        {
          "parameter": "rule",
          "property": "status",
          "operator": "not_equals",
          "value": "retired",
          "failure_message": "Rule is already retired."
        }
      ],
      "edits": [
        {
          "object_parameter": "rule",
          "set": {
            "status": "retired",
            "status_reason": "$reason"
          }
        }
      ]
    }
  ],
  "functions": [
    {
      "api_name": "framework_coverage",
      "input": "ObjectStore, framework, optional PIF set, minimum strength",
      "output": "struct",
      "reuses": "ehs_hfo.foundry.functions.framework_coverage",
      "description": "How much of one framework a set of PIFs (default: all) reaches through non-rejected crosswalk entries at or above a match strength, and which PIFs have a counterpart, an asserted absence, or neither."
    },
    {
      "api_name": "rules_triggered",
      "input": "ObjectStore, PIF set",
      "output": "list of Rule objects",
      "reuses": "ehs_hfo.foundry.functions.rules_triggered",
      "description": "Active suggester rules whose PIF is in the set."
    },
    {
      "api_name": "rules_triggered_by_text",
      "input": "ObjectStore, free text",
      "output": "dict PIF -> matched phrases",
      "reuses": "ehs_hfo.suggest.suggest",
      "description": "Runs the active Rule objects over text with the suggester's own matcher."
    },
    {
      "api_name": "pif_evidence",
      "input": "ObjectStore, PIF",
      "output": "struct",
      "reuses": "ehs_hfo.foundry.functions.pif_evidence",
      "description": "Non-rejected excerpts and distinct investigations coded to a PIF, split by finding and recommendation."
    },
    {
      "api_name": "coverage_table",
      "input": "ObjectStore",
      "output": "struct",
      "reuses": "ehs_hfo.foundry.functions.coverage_table",
      "description": "The per-framework and per-PIF counts behind docs/ontology-coverage.md."
    }
  ]
}
