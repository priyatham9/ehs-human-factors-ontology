        },
        {
          "api_name": "source",
          "type": "string",
          "nullable": false,
          "description": "Committed file the object was read from."
        }
      ]
    },
    {
      "api_name": "CrosswalkEntry",
      "display_name": "Crosswalk entry",
      "plural_display_name": "Crosswalk entries",
      "description": "One PIF-to-framework-item correspondence with its match strength (close, partial or broader). The join object between Pif and FrameworkItem.",
      "backing_dataset": "crosswalk/crosswalk.csv rows with an external item",
      "primary_key": "entry_key",
      "title_property": "entry_key",
      "properties": [
        {
          "api_name": "entry_key",
          "type": "string",
          "nullable": false,
          "description": "factor_curie|external_curie."
        },
        {
          "api_name": "factor_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to Pif."
        },
        {
          "api_name": "external_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to FrameworkItem."
        },
        {
          "api_name": "framework_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to Framework."
        },
        {
          "api_name": "match_strength",
          "type": "string",
          "nullable": false,
          "description": "close, partial or broader."
        },
        {
          "api_name": "source_refs",
          "type": "string_array",
          "nullable": false,
          "description": "Citation keys."
        },
        {
          "api_name": "note",
          "type": "string",
          "nullable": true,
          "description": "Alignment note."
        },
        {
          "api_name": "source",
          "type": "string",
          "nullable": false,
          "description": "Committed file the object was read from."
        },
        {
          "api_name": "review_status",
          "type": "string",
          "nullable": false,
          "description": "Writeback: active/under_review/rejected state of the crosswalk entry.",
          "editable": true,
          "default": "active"
        },
        {
          "api_name": "review_reason",
          "type": "string",
          "nullable": true,
          "description": "Writeback: coded reason.",
          "editable": true
        },
        {
          "api_name": "review_note",
          "type": "string",
          "nullable": true,
          "description": "Writeback: free-text justification.",
          "editable": true
        }
      ]
    },
    {
      "api_name": "AssertedAbsence",
      "display_name": "Asserted absence",
      "plural_display_name": "Asserted absences",
      "description": "The ontology asserts that a framework has no counterpart for a PIF. Kept apart from CrosswalkEntry so an absence is never read as a match.",
      "backing_dataset": "crosswalk/crosswalk.csv rows with match_strength none",
      "primary_key": "absence_key",
      "title_property": "absence_key",
      "properties": [
        {
          "api_name": "absence_key",
          "type": "string",
          "nullable": false,
          "description": "factor_curie|framework_curie."
        },
        {
          "api_name": "factor_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to Pif."
        },
        {
          "api_name": "framework_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to Framework."
        },
        {
          "api_name": "note",
          "type": "string",
          "nullable": true,
          "description": "Why there is no counterpart."
        },
        {
          "api_name": "source",
          "type": "string",
          "nullable": false,
          "description": "Committed file the object was read from."
        }
      ]
    },
    {
      "api_name": "Rule",
      "display_name": "Suggester rule",
      "plural_display_name": "Suggester rules",
      "description": "A curated phrase rule that suggests a PIF (and the framework item it was written against) from free text.",
      "backing_dataset": "crosswalk/pif_rules.csv",
      "primary_key": "rule_id",
      "title_property": "rule_id",
      "properties": [
