{
  "ontology": {
    "api_name": "ehs_hfo_human_factors",
    "display_name": "EHS human-factors ontology (PIFs, crosswalk, rules, CSB evidence)",
    "version": "1.0.0",
    "description": "Foundry-style object/link/action/function view of the repository's committed data: the performance-influencing factors, their crosswalk to CREAM, HFACS, HSE PIFs, SPAR-H and IDHEAS-G, the curated suggester rules, and the CSB investigations coded to the PIFs. Independent design in the style of a Palantir Foundry Ontology; not affiliated with Palantir. Every object is read from a committed file; nothing is invented."
  },
  "object_types": [
    {
      "api_name": "ContextDimension",
      "display_name": "Context dimension",
      "plural_display_name": "Context dimensions",
      "description": "One of the four context dimensions the PIFs are grouped under; carries the IDHEAS-G category it corresponds to.",
      "backing_dataset": "ontology/ehs-hfo.ttl (ehs:ContextDimension)",
      "primary_key": "dimension_curie",
      "title_property": "label",
      "properties": [
        {
          "api_name": "dimension_curie",
          "type": "string",
          "nullable": false,
          "description": "CURIE, e.g. ehs:TaskContext."
        },
        {
          "api_name": "label",
          "type": "string",
          "nullable": false,
          "description": "Label."
        },
        {
          "api_name": "definition",
          "type": "string",
          "nullable": true,
          "description": "SKOS definition."
        },
        {
          "api_name": "idheas_item_curie",
          "type": "string",
          "nullable": true,
          "description": "Foreign key to FrameworkItem: the IDHEAS-G category this dimension corresponds to."
        },
        {
          "api_name": "source",
          "type": "string",
          "nullable": false,
          "description": "Committed file the object was read from."
        }
      ]
    },
    {
      "api_name": "Pif",
      "display_name": "Performance-influencing factor",
      "plural_display_name": "Performance-influencing factors",
      "description": "A PIF of the ontology: a condition of the task, operation, human or system context that shifts the likelihood of an error mode.",
      "backing_dataset": "ontology/ehs-hfo.ttl (ehs:PerformanceInfluencingFactor)",
      "primary_key": "factor_curie",
      "title_property": "label",
      "properties": [
        {
          "api_name": "factor_curie",
          "type": "string",
          "nullable": false,
          "description": "CURIE, e.g. ehs:Training."
        },
        {
          "api_name": "label",
          "type": "string",
          "nullable": false,
          "description": "Label."
        },
        {
          "api_name": "verbatim_label",
          "type": "string",
          "nullable": true,
          "description": "Label as worded in the source framework."
        },
        {
          "api_name": "dimension_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to ContextDimension."
        },
        {
          "api_name": "source_refs",
          "type": "string_array",
          "nullable": false,
          "description": "Citation keys in CITATIONS.md."
        },
        {
          "api_name": "comment",
          "type": "string",
          "nullable": true,
          "description": "Definition or scoping note."
        },
        {
          "api_name": "source",
          "type": "string",
          "nullable": false,
          "description": "Committed file the object was read from."
        }
      ]
    },
    {
      "api_name": "Framework",
      "display_name": "External framework",
      "plural_display_name": "External frameworks",
      "description": "A published human-factors framework the PIFs are aligned to (CREAM, HFACS, HSE PIFs, SPAR-H, IDHEAS-G).",
      "backing_dataset": "ontology/ehs-hfo.ttl (ehs:ExternalFramework)",
      "primary_key": "framework_curie",
      "title_property": "label",
      "properties": [
        {
          "api_name": "framework_curie",
          "type": "string",
          "nullable": false,
          "description": "CURIE, e.g. xw:fw-CREAM."
        },
        {
          "api_name": "label",
          "type": "string",
          "nullable": false,
          "description": "Short name."
        },
        {
          "api_name": "citation",
          "type": "string",
          "nullable": true,
          "description": "Full citation."
        },
        {
          "api_name": "source",
          "type": "string",
          "nullable": false,
          "description": "Committed file the object was read from."
        }
      ]
    },
    {
      "api_name": "FrameworkItem",
      "display_name": "Framework item",
      "plural_display_name": "Framework items",
      "description": "One factor, category or condition of an external framework, e.g. an IDHEAS-G category or a CREAM common performance condition.",
      "backing_dataset": "ontology/ehs-hfo.ttl (ehs:ExternalFactor)",
      "primary_key": "external_curie",
      "title_property": "label",
      "properties": [
        {
          "api_name": "external_curie",
          "type": "string",
          "nullable": false,
          "description": "CURIE, e.g. xw:cream-AvailabilityOfProcedures."
        },
        {
          "api_name": "label",
          "type": "string",
          "nullable": false,
          "description": "Label."
        },
        {
          "api_name": "verbatim_label",
          "type": "string",
          "nullable": true,
          "description": "Label as worded in the framework."
        },
        {
          "api_name": "framework_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to Framework."
        },
        {
          "api_name": "out_of_scope_note",
          "type": "string",
          "nullable": true,
