          "nullable": false,
          "description": "Foreign key to Pif."
        },
        {
          "api_name": "external_curie",
          "type": "string",
          "nullable": false,
          "description": "Foreign key to FrameworkItem."
        },
        {
          "api_name": "phrase",
          "type": "string",
          "nullable": false,
          "description": "Whole-word phrase; trailing * matches any ending."
        },
        {
          "api_name": "rationale",
          "type": "string",
          "nullable": false,
          "description": "Why the phrase indicates the factor."
