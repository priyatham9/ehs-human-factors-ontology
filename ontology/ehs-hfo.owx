  <NamedIndividual IRI="ehs:affectsFailureMode">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">The failure mode, of a specific macrocognitive function, whose likelihood a degraded PIF is taken to raise. Every affectsFailureMode assertion must point to a failure mode of a function the PIF appliesToFunction.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:domain" />
      <NamedIndividual IRI="ehs:PerformanceInfluencingFactor" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">affects cognitive failure mode</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:range" />
      <NamedIndividual IRI="ehs:CognitiveFailureMode" />
    </ObjectPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:appliesToFunction">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">A PIF is applicable only relative to the macrocognitive function whose task it affects. This property records that function-specific applicability instead of treating the PIF as a free-standing context variable.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:domain" />
      <NamedIndividual IRI="ehs:PerformanceInfluencingFactor" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">applies to macrocognitive function</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:range" />
      <NamedIndividual IRI="ehs:MacrocognitiveFunction" />
    </ObjectPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:approximatesFailureMode">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">An SRK/GEMS error mode and the IDHEAS-G failure mode it most nearly corresponds to. This is a compatibility mapping made by the author of this repository, not a claim found in either source. See docs/COMPATIBILITY.md for where it is clean and where it is not.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:domain" />
      <NamedIndividual IRI="ehs:ErrorMode" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">approximates cognitive failure mode</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:range" />
      <NamedIndividual IRI="ehs:CognitiveFailureMode" />
    </ObjectPropertyAssertion>
  </NamedIndividual>
