      <NamedIndividual IRI="ehs:ErrorMode" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">arises at</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:range" />
      <NamedIndividual IRI="ehs:ControlLevel" />
    </ObjectPropertyAssertion>
  </NamedIndividual>
