  <ObjectProperty IRI="ehs:degradationRaisesDemandOn" />
  <ObjectProperty IRI="ehs:externalFactor" />
  <ObjectProperty IRI="ehs:externalParent" />
  <ObjectProperty IRI="ehs:failureOfFunction" />
  <ObjectProperty IRI="ehs:hasMatchStrength" />
  <ObjectProperty IRI="ehs:inDimension" />
  <ObjectProperty IRI="ehs:localFactor" />
  <ObjectProperty IRI="ehs:noCounterpartIn" />
  <DatatypeProperty IRI="ehs:observableProxy" />
  <DatatypeProperty IRI="ehs:ordinalRank" />
  <DatatypeProperty IRI="ehs:outOfScopeNote" />
  <ObjectProperty IRI="ehs:predisposesTo" />
  <DatatypeProperty IRI="ehs:sourceRef" />
  <ObjectProperty IRI="ehs:uncoveredFactor" />
  <DatatypeProperty IRI="ehs:verbatimLabel" />
  <DatatypeProperty IRI="skos:definition" />
  <NamedIndividual IRI="&lt;https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo&gt;">
    <DataPropertyAssertion>
      <DataProperty IRI="dcterms:creator" />
      <Literal>Priyatham Chimmani</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="dcterms:description" />
      <Literal xml:lang="en">A machine-readable encoding of the four-context performance-influencing-factor
structure of IDHEAS-G (NUREG-2198), relabelled for occupational and process EHS
use, together with an explicit crosswalk to SPAR-H, CREAM, HFACS and the HSE
PIF list. The ontology asserts no human error probabilities and no calibrated
risk numbers.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="dcterms:license" />
      <NamedIndividual IRI="&lt;https://opensource.org/licenses/MIT&gt;" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="dcterms:title" />
      <Literal xml:lang="en">EHS Human Factors Ontology (EHS-HFO)</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="owl:versionInfo" />
      <Literal>0.1.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">Adoption, not invention. The four-category structure is the NRC's (NUREG-2198, 2021).</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:ActionExecution">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">action execution</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Carrying out the selected response on the plant.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:Alignment">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">alignment</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">A reified, individually cited assertion that one local factor corresponds to one
external factor with a stated strength of match.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:CognitiveFailureMode">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">IDHEAS-G enumerates several finer failure modes within each function. Only the function-level failure is modelled here; the finer modes are not reproduced, so nothing below this granularity is claimed.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">cognitive failure mode</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">The way a macrocognitive function can fail. IDHEAS-G defines failure modes relative to a function, and defines PIF effects relative to those failure modes.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:ContextDimension">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="owl:disjointWith" />
      <NamedIndividual IRI="ehs:PerformanceInfluencingFactor" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">context dimension</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">One of the four categories of context into which performance-influencing factors are grouped.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:ControlLevel">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>rasmussen1983</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">cognitive control level</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">A level of cognitive control in the skill/rule/knowledge framework.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:CoverageGap">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">A gap is compatible with an ehs:MatchPartial alignment and only with that
strength. Partial overlap is not coverage: xw:cream-TimeOfDay overlaps
ehs:MentalFatigue at the edges and is still a gap, because neither factor
represents circadian phase. A gap alongside a close, broader or narrower match
would be a contradiction, and tests/test_crosswalk.py fails on one.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">coverage gap</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">An external factor this ontology does not cover, or covers only at partial strength, recorded explicitly.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:Decisionmaking">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">decisionmaking</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Selecting a response given the situation model.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:Detection">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">detection</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Noticing and recognising cues, alarms and other information that a change in plant state has occurred.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:EquipmentAndTools">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:affectsFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfActionExecution" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:appliesToFunction" />
      <NamedIndividual IRI="ehs:ActionExecution" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:boundaryNote" />
      <Literal>Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:inDimension" />
      <NamedIndividual IRI="ehs:SystemContext" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:observableProxy" />
      <Literal>CMMS overdue preventive-maintenance backlog for the asset named on the work order.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:verbatimLabel" />
      <Literal>Equipment and tools</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">Equipment and tools</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:ErrorMode">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>rasmussen1983</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>reason1990</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="owl:disjointWith" />
      <NamedIndividual IRI="ehs:ControlLevel" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="owl:disjointWith" />
      <NamedIndividual IRI="ehs:CognitiveFailureMode" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">error mode</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">A class of human failure distinguished by the level of cognitive control at which it arises.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:ExternalFactor">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">external factor</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">A factor, PSF, PIF, CPC or category belonging to an external framework. The IRI is
local to this repository: the cited bodies do not publish IRIs for these concepts.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:ExternalFramework">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">external framework</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">A published human-factors or human-reliability framework external to this ontology.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:FactorLevel">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">factor level</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">An ordinal state assigned to a factor for a specific scenario. Ordinal only; the ranks are not on a probability scale.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:FailureOfActionExecution">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:failureOfFunction" />
      <NamedIndividual IRI="ehs:ActionExecution" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">failure of action execution</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:FailureOfDecisionmaking">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:failureOfFunction" />
      <NamedIndividual IRI="ehs:Decisionmaking" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">failure of decisionmaking</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:FailureOfDetection">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:failureOfFunction" />
      <NamedIndividual IRI="ehs:Detection" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
