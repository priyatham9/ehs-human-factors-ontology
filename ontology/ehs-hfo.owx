  <NamedIndividual IRI="ehs:degradationRaisesDemandOn">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">Theoretical claim taken from the cited source: degrading this factor pushes
performance toward the named control level. Not an empirically estimated effect.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="rdfs:domain" />
      <NamedIndividual IRI="ehs:PerformanceInfluencingFactor" />
    </ObjectPropertyAssertion>
