      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">failure of detection</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:FailureOfInterteamCoordination">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:failureOfFunction" />
      <NamedIndividual IRI="ehs:InterteamCoordination" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">failure of interteam coordination</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:FailureOfUnderstanding">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:failureOfFunction" />
      <NamedIndividual IRI="ehs:Understanding" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">failure of understanding</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:HumanContext">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:correspondsToIdheasCategory" />
      <NamedIndividual IRI="xw:idheas-Personnel" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">Synonym for the IDHEAS-G category 'Personnel'.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">Human context</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Attributes of the people, teams and organisational processes performing the work.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:HumanSystemInterface">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:affectsFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfDetection" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:affectsFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfActionExecution" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:appliesToFunction" />
      <NamedIndividual IRI="ehs:Detection" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:appliesToFunction" />
      <NamedIndividual IRI="ehs:ActionExecution" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:boundaryNote" />
      <Literal>Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:inDimension" />
      <NamedIndividual IRI="ehs:SystemContext" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:observableProxy" />
      <Literal>DCS alarm-rate statistics; count of standing alarms per operator per hour.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:predisposesTo" />
      <NamedIndividual IRI="ehs:SkillBasedSlipOrLapse" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:verbatimLabel" />
      <Literal>HSI</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">Human-system interface</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:InformationAvailabilityAndReliability">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:affectsFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfDetection" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:affectsFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfUnderstanding" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:appliesToFunction" />
      <NamedIndividual IRI="ehs:Detection" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:appliesToFunction" />
      <NamedIndividual IRI="ehs:Understanding" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:boundaryNote" />
      <Literal>Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:inDimension" />
      <NamedIndividual IRI="ehs:TaskContext" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:observableProxy" />
      <Literal>Instrument out-of-service list; count of failed or bypassed transmitters on the unit.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:predisposesTo" />
      <NamedIndividual IRI="ehs:RuleBasedMistake" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:predisposesTo" />
      <NamedIndividual IRI="ehs:KnowledgeBasedMistake" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:verbatimLabel" />
      <Literal>Information availability and reliability</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">Information availability and reliability</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:InterteamCoordination">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">interteam coordination</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Communication and coordination across teams and organisational units.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:KnowledgeBasedControl">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>rasmussen1983</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">knowledge-based control</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Performance in an unfamiliar situation for which no rule is available, requiring reasoning from a mental model of the system.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:KnowledgeBasedMistake">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:approximatesFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfUnderstanding" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:approximatesFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfDecisionmaking" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:arisesAt" />
      <NamedIndividual IRI="ehs:KnowledgeBasedControl" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>reason1990</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">knowledge-based mistake</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Failure of reasoning in a novel situation handled without an applicable rule.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:LevelDegraded">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:ordinalRank" />
      <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">degraded</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Worse than nominal in a way an analyst would record.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:LevelEnhanced">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:ordinalRank" />
      <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">2</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>gertman2005</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">SPAR-H is one of the few methods that admits beneficial PSF influence; the level is retained here for that reason.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">enhanced</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Better than the nominal condition assumed by the base assessment.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:LevelNominal">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:ordinalRank" />
      <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">1</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">nominal</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">The condition assumed by the base assessment; no adjustment warranted.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:LevelSeverelyDegraded">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:ordinalRank" />
      <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">-1</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">severely degraded</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Worse than nominal to a degree that would ordinarily stop or re-plan the task.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:LevelUnknown">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:ordinalRank" />
      <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">-99</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">Kept separate on purpose. Treating missing data as nominal is the single most common way a screening tool understates a hazard.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">unknown</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Not assessed. Distinct from nominal: an unassessed factor is not a satisfactory one.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MacrocognitiveFunction">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="owl:disjointWith" />
      <NamedIndividual IRI="ehs:ControlLevel" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">macrocognitive function</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">One of the five high-level cognitive functions IDHEAS-G uses to model a human action: detection, understanding, decisionmaking, action execution, and interteam coordination.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MatchBroader">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">broader</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">The external factor subsumes the local factor along with other content.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MatchClose">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">close</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Same construct; wording or scope differs in ways unlikely to change an assessment.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MatchExact">
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>groth2012</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">exact</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Same construct, same scope, wording effectively identical.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MatchNarrower">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">narrower</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">The external factor covers only part of the local factor.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MatchPartial">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">Groth and Mosleh (2012) report that PIFs across methods are not defined specifically enough for consistent interpretation. Rows marked partial are where that bites.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">partial</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">Overlapping but non-nested constructs; the correspondence is interpretive.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MatchStrength">
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">match strength</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="skos:definition" />
      <Literal xml:lang="en">How closely a local factor corresponds to an external factor.</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
  <NamedIndividual IRI="ehs:MentalFatigue">
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:affectsFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfDetection" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:affectsFailureMode" />
      <NamedIndividual IRI="ehs:FailureOfActionExecution" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:appliesToFunction" />
      <NamedIndividual IRI="ehs:Detection" />
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:appliesToFunction" />
      <NamedIndividual IRI="ehs:ActionExecution" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:boundaryNote" />
      <Literal>Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:boundaryNote" />
      <Literal>IDHEAS-G files mental fatigue under Task. An occupational-safety practitioner would ordinarily file it under Human or Operational. The disagreement is recorded rather than resolved.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:inDimension" />
      <NamedIndividual IRI="ehs:TaskContext" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:observableProxy" />
      <Literal>Hours elapsed since shift start; consecutive shifts worked; overtime hours in the trailing 7 days.</Literal>
    </DataPropertyAssertion>
    <ObjectPropertyAssertion>
      <ObjectProperty IRI="ehs:predisposesTo" />
      <NamedIndividual IRI="ehs:SkillBasedSlipOrLapse" />
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:sourceRef" />
      <Literal>nureg2198</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="ehs:verbatimLabel" />
      <Literal>Mental fatigue</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:comment" />
      <Literal xml:lang="en">Time-on-shift is the natural proxy here, and it is also where this ontology's claims stop: hour-of-shift injury counts are not risk rates without an exposure denominator (Hanecke et al. 1998; Folkard and Tucker 2003).</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
      <DataProperty IRI="rdfs:label" />
      <Literal xml:lang="en">Mental fatigue</Literal>
    </DataPropertyAssertion>
  </NamedIndividual>
