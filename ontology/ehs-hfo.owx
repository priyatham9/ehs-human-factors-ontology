  <Class IRI="ehs:PerformanceInfluencingFactor" />
  <DatatypeProperty IRI="dcterms:bibliographicCitation" />
  <DatatypeProperty IRI="dcterms:creator" />
  <DatatypeProperty IRI="dcterms:description" />
  <ObjectProperty IRI="dcterms:license" />
