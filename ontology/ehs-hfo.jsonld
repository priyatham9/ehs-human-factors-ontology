        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:ControlLevel"
        }
      ],
      "rdfs:label": {
        "@value": "skill-based control",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Sensory-motor performance running automatically, without conscious control, once an intention is formed.",
