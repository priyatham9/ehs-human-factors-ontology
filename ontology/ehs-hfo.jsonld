    {
      "@id": "ehs:RuleBasedControl",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:ControlLevel"
        }
      ],
      "rdfs:label": {
        "@value": "rule-based control",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Performance governed by stored rules or procedures for a familiar situation.",
        "@language": "en"
      },
      "ehs:sourceRef": "rasmussen1983"
    },
    {
      "@id": "ehs:RuleBasedMistake",
