{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "ehs": "https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "xw": "https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#"
  },
  "@graph": [
    {
      "@id": "<https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo>",
      "dcterms:creator": "Priyatham Chimmani",
      "dcterms:description": {
        "@value": "A machine-readable encoding of the four-context performance-influencing-factor\nstructure of IDHEAS-G (NUREG-2198), relabelled for occupational and process EHS\nuse, together with an explicit crosswalk to SPAR-H, CREAM, HFACS and the HSE\nPIF list. The ontology asserts no human error probabilities and no calibrated\nrisk numbers.",
        "@language": "en"
      },
      "dcterms:license": {
        "@id": "<https://opensource.org/licenses/MIT>"
      },
      "dcterms:title": {
        "@value": "EHS Human Factors Ontology (EHS-HFO)",
        "@language": "en"
      },
      "rdf:type": {
        "@id": "owl:Ontology"
      },
      "rdfs:comment": {
        "@value": "Adoption, not invention. The four-category structure is the NRC's (NUREG-2198, 2021).",
        "@language": "en"
      },
      "owl:versionInfo": "0.1.0"
    },
    {
      "@id": "ehs:ActionExecution",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MacrocognitiveFunction"
        }
      ],
      "rdfs:label": {
        "@value": "action execution",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Carrying out the selected response on the plant.",
        "@language": "en"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:Alignment",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "alignment",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A reified, individually cited assertion that one local factor corresponds to one\nexternal factor with a stated strength of match.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:CognitiveFailureMode",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:comment": {
        "@value": "IDHEAS-G enumerates several finer failure modes within each function. Only the function-level failure is modelled here; the finer modes are not reproduced, so nothing below this granularity is claimed.",
        "@language": "en"
      },
      "rdfs:label": {
        "@value": "cognitive failure mode",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The way a macrocognitive function can fail. IDHEAS-G defines failure modes relative to a function, and defines PIF effects relative to those failure modes.",
        "@language": "en"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:ContextDimension",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "context dimension",
        "@language": "en"
      },
      "owl:disjointWith": {
        "@id": "ehs:PerformanceInfluencingFactor"
      },
      "skos:definition": {
        "@value": "One of the four categories of context into which performance-influencing factors are grouped.",
        "@language": "en"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:ControlLevel",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "cognitive control level",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A level of cognitive control in the skill/rule/knowledge framework.",
        "@language": "en"
      },
      "ehs:sourceRef": "rasmussen1983"
    },
    {
      "@id": "ehs:CoverageGap",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:comment": {
        "@value": "A gap is compatible with an ehs:MatchPartial alignment and only with that\nstrength. Partial overlap is not coverage: xw:cream-TimeOfDay overlaps\nehs:MentalFatigue at the edges and is still a gap, because neither factor\nrepresents circadian phase. A gap alongside a close, broader or narrower match\nwould be a contradiction, and tests/test_crosswalk.py fails on one.",
        "@language": "en"
      },
      "rdfs:label": {
        "@value": "coverage gap",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An external factor this ontology does not cover, or covers only at partial strength, recorded explicitly.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:Decisionmaking",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MacrocognitiveFunction"
        }
      ],
      "rdfs:label": {
        "@value": "decisionmaking",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Selecting a response given the situation model.",
        "@language": "en"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:Detection",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MacrocognitiveFunction"
        }
      ],
      "rdfs:label": {
        "@value": "detection",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Noticing and recognising cues, alarms and other information that a change in plant state has occurred.",
        "@language": "en"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:EquipmentAndTools",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:PerformanceInfluencingFactor"
        }
      ],
      "rdfs:label": {
        "@value": "Equipment and tools",
        "@language": "en"
      },
      "ehs:affectsFailureMode": {
        "@id": "ehs:FailureOfActionExecution"
      },
      "ehs:appliesToFunction": {
        "@id": "ehs:ActionExecution"
      },
      "ehs:boundaryNote": "Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.",
      "ehs:inDimension": {
        "@id": "ehs:SystemContext"
      },
      "ehs:observableProxy": "CMMS overdue preventive-maintenance backlog for the asset named on the work order.",
      "ehs:sourceRef": "nureg2198",
      "ehs:verbatimLabel": "Equipment and tools"
    },
    {
      "@id": "ehs:ErrorMode",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "error mode",
        "@language": "en"
      },
      "owl:disjointWith": [
        {
          "@id": "ehs:CognitiveFailureMode"
        },
        {
          "@id": "ehs:ControlLevel"
        }
      ],
      "skos:definition": {
        "@value": "A class of human failure distinguished by the level of cognitive control at which it arises.",
        "@language": "en"
      },
      "ehs:sourceRef": [
        "rasmussen1983",
        "reason1990"
      ]
    },
    {
      "@id": "ehs:ExternalFactor",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "external factor",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A factor, PSF, PIF, CPC or category belonging to an external framework. The IRI is\nlocal to this repository: the cited bodies do not publish IRIs for these concepts.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:ExternalFramework",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "external framework",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A published human-factors or human-reliability framework external to this ontology.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:FactorLevel",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "factor level",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An ordinal state assigned to a factor for a specific scenario. Ordinal only; the ranks are not on a probability scale.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:FailureOfActionExecution",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:CognitiveFailureMode"
        }
      ],
      "rdfs:label": {
        "@value": "failure of action execution",
        "@language": "en"
      },
      "ehs:failureOfFunction": {
        "@id": "ehs:ActionExecution"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:FailureOfDecisionmaking",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:CognitiveFailureMode"
        }
      ],
      "rdfs:label": {
        "@value": "failure of decisionmaking",
        "@language": "en"
      },
      "ehs:failureOfFunction": {
        "@id": "ehs:Decisionmaking"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:FailureOfDetection",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:CognitiveFailureMode"
        }
      ],
      "rdfs:label": {
        "@value": "failure of detection",
        "@language": "en"
      },
      "ehs:failureOfFunction": {
        "@id": "ehs:Detection"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:FailureOfInterteamCoordination",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:CognitiveFailureMode"
        }
      ],
      "rdfs:label": {
        "@value": "failure of interteam coordination",
        "@language": "en"
      },
      "ehs:failureOfFunction": {
        "@id": "ehs:InterteamCoordination"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:FailureOfUnderstanding",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:CognitiveFailureMode"
        }
      ],
      "rdfs:label": {
        "@value": "failure of understanding",
        "@language": "en"
      },
      "ehs:failureOfFunction": {
        "@id": "ehs:Understanding"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:HumanContext",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:ContextDimension"
        }
      ],
      "rdfs:comment": {
        "@value": "Synonym for the IDHEAS-G category 'Personnel'.",
        "@language": "en"
      },
      "rdfs:label": {
        "@value": "Human context",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Attributes of the people, teams and organisational processes performing the work.",
        "@language": "en"
      },
      "ehs:correspondsToIdheasCategory": {
        "@id": "xw:idheas-Personnel"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:HumanSystemInterface",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:PerformanceInfluencingFactor"
        }
      ],
      "rdfs:label": {
        "@value": "Human-system interface",
        "@language": "en"
      },
      "ehs:affectsFailureMode": [
        {
          "@id": "ehs:FailureOfActionExecution"
        },
        {
          "@id": "ehs:FailureOfDetection"
        }
      ],
      "ehs:appliesToFunction": [
        {
          "@id": "ehs:ActionExecution"
        },
        {
          "@id": "ehs:Detection"
        }
      ],
      "ehs:boundaryNote": "Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.",
      "ehs:inDimension": {
        "@id": "ehs:SystemContext"
      },
      "ehs:observableProxy": "DCS alarm-rate statistics; count of standing alarms per operator per hour.",
      "ehs:predisposesTo": {
        "@id": "ehs:SkillBasedSlipOrLapse"
      },
      "ehs:sourceRef": "nureg2198",
      "ehs:verbatimLabel": "HSI"
    },
    {
      "@id": "ehs:InformationAvailabilityAndReliability",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:PerformanceInfluencingFactor"
        }
      ],
      "rdfs:label": {
        "@value": "Information availability and reliability",
        "@language": "en"
      },
      "ehs:affectsFailureMode": [
        {
          "@id": "ehs:FailureOfDetection"
        },
        {
          "@id": "ehs:FailureOfUnderstanding"
        }
      ],
      "ehs:appliesToFunction": [
        {
          "@id": "ehs:Detection"
        },
        {
          "@id": "ehs:Understanding"
        }
      ],
      "ehs:boundaryNote": "Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.",
      "ehs:inDimension": {
        "@id": "ehs:TaskContext"
      },
      "ehs:observableProxy": "Instrument out-of-service list; count of failed or bypassed transmitters on the unit.",
      "ehs:predisposesTo": [
        {
          "@id": "ehs:KnowledgeBasedMistake"
        },
        {
          "@id": "ehs:RuleBasedMistake"
        }
      ],
      "ehs:sourceRef": "nureg2198",
      "ehs:verbatimLabel": "Information availability and reliability"
    },
    {
      "@id": "ehs:InterteamCoordination",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MacrocognitiveFunction"
        }
      ],
      "rdfs:label": {
        "@value": "interteam coordination",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Communication and coordination across teams and organisational units.",
        "@language": "en"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:KnowledgeBasedControl",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:ControlLevel"
        }
      ],
      "rdfs:label": {
        "@value": "knowledge-based control",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Performance in an unfamiliar situation for which no rule is available, requiring reasoning from a mental model of the system.",
        "@language": "en"
      },
      "ehs:sourceRef": "rasmussen1983"
    },
    {
      "@id": "ehs:KnowledgeBasedMistake",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:ErrorMode"
        }
      ],
      "rdfs:label": {
        "@value": "knowledge-based mistake",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Failure of reasoning in a novel situation handled without an applicable rule.",
        "@language": "en"
      },
      "ehs:approximatesFailureMode": [
        {
          "@id": "ehs:FailureOfDecisionmaking"
        },
        {
          "@id": "ehs:FailureOfUnderstanding"
        }
      ],
      "ehs:arisesAt": {
        "@id": "ehs:KnowledgeBasedControl"
      },
      "ehs:sourceRef": "reason1990"
    },
    {
      "@id": "ehs:LevelDegraded",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:FactorLevel"
        }
      ],
      "rdfs:label": {
        "@value": "degraded",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Worse than nominal in a way an analyst would record.",
        "@language": "en"
      },
      "ehs:ordinalRank": {
        "@value": "0",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "ehs:LevelEnhanced",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:FactorLevel"
        }
      ],
      "rdfs:comment": {
        "@value": "SPAR-H is one of the few methods that admits beneficial PSF influence; the level is retained here for that reason.",
        "@language": "en"
      },
      "rdfs:label": {
        "@value": "enhanced",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Better than the nominal condition assumed by the base assessment.",
        "@language": "en"
      },
      "ehs:ordinalRank": {
        "@value": "2",
        "@type": "xsd:integer"
      },
      "ehs:sourceRef": "gertman2005"
    },
    {
      "@id": "ehs:LevelNominal",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:FactorLevel"
        }
      ],
      "rdfs:label": {
        "@value": "nominal",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The condition assumed by the base assessment; no adjustment warranted.",
        "@language": "en"
      },
      "ehs:ordinalRank": {
        "@value": "1",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "ehs:LevelSeverelyDegraded",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:FactorLevel"
        }
      ],
      "rdfs:label": {
        "@value": "severely degraded",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Worse than nominal to a degree that would ordinarily stop or re-plan the task.",
        "@language": "en"
      },
      "ehs:ordinalRank": {
        "@value": "-1",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "ehs:LevelUnknown",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:FactorLevel"
        }
      ],
      "rdfs:comment": {
        "@value": "Kept separate on purpose. Treating missing data as nominal is the single most common way a screening tool understates a hazard.",
        "@language": "en"
      },
      "rdfs:label": {
        "@value": "unknown",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Not assessed. Distinct from nominal: an unassessed factor is not a satisfactory one.",
        "@language": "en"
      },
      "ehs:ordinalRank": {
        "@value": "-99",
        "@type": "xsd:integer"
      }
    },
    {
      "@id": "ehs:MacrocognitiveFunction",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "macrocognitive function",
        "@language": "en"
      },
      "owl:disjointWith": {
        "@id": "ehs:ControlLevel"
      },
      "skos:definition": {
        "@value": "One of the five high-level cognitive functions IDHEAS-G uses to model a human action: detection, understanding, decisionmaking, action execution, and interteam coordination.",
        "@language": "en"
      },
      "ehs:sourceRef": "nureg2198"
    },
    {
      "@id": "ehs:MatchBroader",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MatchStrength"
        }
      ],
      "rdfs:label": {
        "@value": "broader",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The external factor subsumes the local factor along with other content.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:MatchClose",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MatchStrength"
        }
      ],
      "rdfs:label": {
        "@value": "close",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Same construct; wording or scope differs in ways unlikely to change an assessment.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:MatchExact",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MatchStrength"
        }
      ],
      "rdfs:label": {
        "@value": "exact",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Same construct, same scope, wording effectively identical.",
        "@language": "en"
      },
      "ehs:sourceRef": "groth2012"
    },
    {
      "@id": "ehs:MatchNarrower",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MatchStrength"
        }
      ],
      "rdfs:label": {
        "@value": "narrower",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The external factor covers only part of the local factor.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:MatchPartial",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:MatchStrength"
        }
      ],
      "rdfs:comment": {
        "@value": "Groth and Mosleh (2012) report that PIFs across methods are not defined specifically enough for consistent interpretation. Rows marked partial are where that bites.",
        "@language": "en"
      },
      "rdfs:label": {
        "@value": "partial",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Overlapping but non-nested constructs; the correspondence is interpretive.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:MatchStrength",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": {
        "@value": "match strength",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "How closely a local factor corresponds to an external factor.",
        "@language": "en"
      }
    },
    {
      "@id": "ehs:MentalFatigue",
      "rdf:type": [
        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:PerformanceInfluencingFactor"
        }
      ],
      "rdfs:comment": {
        "@value": "Time-on-shift is the natural proxy here, and it is also where this ontology's claims stop: hour-of-shift injury counts are not risk rates without an exposure denominator (Hanecke et al. 1998; Folkard and Tucker 2003).",
        "@language": "en"
      },
      "rdfs:label": {
        "@value": "Mental fatigue",
        "@language": "en"
      },
      "ehs:affectsFailureMode": [
        {
          "@id": "ehs:FailureOfActionExecution"
        },
        {
          "@id": "ehs:FailureOfDetection"
        }
      ],
      "ehs:appliesToFunction": [
        {
          "@id": "ehs:ActionExecution"
        },
        {
          "@id": "ehs:Detection"
        }
      ],
      "ehs:boundaryNote": [
        "Function assignment is the repository author's reading of NUREG-2198, not a table copied from it.",
        "IDHEAS-G files mental fatigue under Task. An occupational-safety practitioner would ordinarily file it under Human or Operational. The disagreement is recorded rather than resolved."
      ],
      "ehs:inDimension": {
        "@id": "ehs:TaskContext"
      },
      "ehs:observableProxy": "Hours elapsed since shift start; consecutive shifts worked; overtime hours in the trailing 7 days.",
      "ehs:predisposesTo": {
        "@id": "ehs:SkillBasedSlipOrLapse"
      },
      "ehs:sourceRef": "nureg2198",
      "ehs:verbatimLabel": "Mental fatigue"
    },
