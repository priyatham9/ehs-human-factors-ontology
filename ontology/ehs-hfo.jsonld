        }
      ],
      "rdfs:label": {
        "@value": "rule-based mistake",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Correct execution of a wrong rule, or misapplication of a normally good rule.",
        "@language": "en"
      },
      "ehs:approximatesFailureMode": {
        "@id": "ehs:FailureOfDecisionmaking"
      },
      "ehs:arisesAt": {
        "@id": "ehs:RuleBasedControl"
      },
      "ehs:sourceRef": "reason1990"
    },
    {
      "@id": "ehs:ScenarioFamiliarity",
