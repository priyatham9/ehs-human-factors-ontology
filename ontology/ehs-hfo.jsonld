        {
          "@id": "owl:NamedIndividual"
        },
        {
          "@id": "ehs:PerformanceInfluencingFactor"
        }
      ],
      "rdfs:comment": {
        "@value": "The demand claim is Rasmussen's: an unfamiliar situation for which no rule is stored must be handled at the knowledge-based level.",
