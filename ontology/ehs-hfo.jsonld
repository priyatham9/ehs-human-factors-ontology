        "@id": "owl:ObjectProperty"
      },
      "rdfs:comment": {
        "@value": "The failure mode, of a specific macrocognitive function, whose likelihood a degraded PIF is taken to raise. Every affectsFailureMode assertion must point to a failure mode of a function the PIF appliesToFunction.",
        "@language": "en"
      },
      "rdfs:domain": {
        "@id": "ehs:PerformanceInfluencingFactor"
      },
      "rdfs:label": {
        "@value": "affects cognitive failure mode",
        "@language": "en"
      },
      "rdfs:range": {
        "@id": "ehs:CognitiveFailureMode"
      },
      "ehs:sourceRef": "nureg2198"
