xw:al-Time-hse3 a owl:NamedIndividual , ehs:Alignment ; ehs:localFactor ehs:TimePressureAndStress ; ehs:externalFactor xw:hse-WorkPressures ; ehs:hasMatchStrength ehs:MatchPartial ; ehs:sourceRef "hse_pifs" .

xw:al-Phys-sparh a owl:NamedIndividual , ehs:Alignment ; ehs:localFactor ehs:PhysicalDemands ; ehs:externalFactor xw:sparh-FitnessForDuty ; ehs:hasMatchStrength ehs:MatchPartial ; ehs:sourceRef "gertman2005" .
xw:al-Phys-cream a owl:NamedIndividual , ehs:Alignment ; ehs:localFactor ehs:PhysicalDemands ; ehs:externalFactor xw:cream-WorkingConditions ; ehs:hasMatchStrength ehs:MatchPartial ; ehs:sourceRef "hollnagel1998" .
