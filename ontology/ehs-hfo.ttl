# ehs-hfo.ttl -- EHS Human Factors Ontology (contextual performance-influencing factors)
#
# STATUS OF THE CONTENT IN THIS FILE
# ----------------------------------
# The four "context dimensions" modelled here (Task, Operational, Human, System)
# are NOT a new taxonomy. They are a relabelling of the four PIF context
# categories published by the U.S. Nuclear Regulatory Commission in IDHEAS-G
# (NUREG-2198, 2021), which states verbatim:
#
#   "PIFs are classified according to the four types of context: environment
#    and situation, system, personnel, and task."   (NUREG-2198, Section 3)
#
# Two of the four labels are identical (Task, System); the other two are
# synonyms (Operational <-> Environment and Situation, Human <-> Personnel).
# The twenty factors below are the twenty IDHEAS-G PIFs, adopted unchanged.
# See ../docs/PROVENANCE.md and ../README.md for why this ontology claims
# adoption rather than invention.
#
# The IRIs in this file do NOT currently dereference. They are stable
# identifiers, not resolvable documents.
#
# Licence: MIT (see ../LICENSE)

@prefix ehs:     <https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo#> .
@prefix xw:      <https://priyatham9.github.io/ehs-human-factors-ontology/xwalk#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://priyatham9.github.io/ehs-human-factors-ontology/ehs-hfo>
    a owl:Ontology ;
    dcterms:title "EHS Human Factors Ontology (EHS-HFO)"@en ;
    dcterms:creator "Priyatham Chimmani" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    owl:versionInfo "0.1.0" ;
    dcterms:description """A machine-readable encoding of the four-context performance-influencing-factor
structure of IDHEAS-G (NUREG-2198), relabelled for occupational and process EHS
use, together with an explicit crosswalk to SPAR-H, CREAM, HFACS and the HSE
PIF list. The ontology asserts no human error probabilities and no calibrated
risk numbers."""@en ;
    rdfs:comment "Adoption, not invention. The four-category structure is the NRC's (NUREG-2198, 2021)."@en .


##############################################################################
# 1. Annotation properties
##############################################################################

ehs:sourceRef a owl:AnnotationProperty ;
    rdfs:label "source reference"@en ;
    rdfs:comment "Citation key resolving to an entry in ../CITATIONS.md."@en .

ehs:verbatimLabel a owl:AnnotationProperty ;
    rdfs:label "verbatim label"@en ;
    rdfs:comment "The wording used in the cited source document, transcribed without alteration."@en .

ehs:observableProxy a owl:AnnotationProperty ;
    rdfs:label "observable proxy"@en ;
    rdfs:comment """A routinely collected industrial data element that has been PROPOSED as an
indicator of this factor. These proposals are unvalidated: no study cited in
this repository establishes that any of them measures the factor it is attached
to. They exist to make the measurement question explicit, not to answer it."""@en .

ehs:boundaryNote a owl:AnnotationProperty ;
    rdfs:label "boundary note"@en ;
    rdfs:comment "Records a known disagreement about which context a factor belongs to."@en .


##############################################################################
# 2. Classes
##############################################################################

ehs:ContextDimension a owl:Class ;
    rdfs:label "context dimension"@en ;
    skos:definition "One of the four categories of context into which performance-influencing factors are grouped."@en ;
    ehs:sourceRef "nureg2198" .

ehs:PerformanceInfluencingFactor a owl:Class ;
    rdfs:label "performance-influencing factor"@en ;
    skos:definition "A characteristic of the work context that is held to affect the reliability of human performance."@en ;
    ehs:sourceRef "nureg2198" .

ehs:FactorLevel a owl:Class ;
    rdfs:label "factor level"@en ;
    skos:definition "An ordinal state assigned to a factor for a specific scenario. Ordinal only; the ranks are not on a probability scale."@en .

ehs:ErrorMode a owl:Class ;
    rdfs:label "error mode"@en ;
    skos:definition "A class of human failure distinguished by the level of cognitive control at which it arises."@en ;
    ehs:sourceRef "rasmussen1983" , "reason1990" .

ehs:ControlLevel a owl:Class ;
    rdfs:label "cognitive control level"@en ;
    skos:definition "A level of cognitive control in the skill/rule/knowledge framework."@en ;
    ehs:sourceRef "rasmussen1983" .

ehs:ExternalFramework a owl:Class ;
    rdfs:label "external framework"@en ;
    skos:definition "A published human-factors or human-reliability framework external to this ontology."@en .

ehs:ExternalFactor a owl:Class ;
    rdfs:label "external factor"@en ;
    skos:definition """A factor, PSF, PIF, CPC or category belonging to an external framework. The IRI is
local to this repository: the cited bodies do not publish IRIs for these concepts."""@en .

ehs:Alignment a owl:Class ;
    rdfs:label "alignment"@en ;
    skos:definition """A reified, individually cited assertion that one local factor corresponds to one
external factor with a stated strength of match."""@en .

ehs:MatchStrength a owl:Class ;
    rdfs:label "match strength"@en ;
    skos:definition "How closely a local factor corresponds to an external factor."@en .

ehs:CoverageGap a owl:Class ;
    rdfs:label "coverage gap"@en ;
    skos:definition "An external factor this ontology does not cover, or covers only at partial strength, recorded explicitly."@en ;
    rdfs:comment """A gap is compatible with an ehs:MatchPartial alignment and only with that
strength. Partial overlap is not coverage: xw:cream-TimeOfDay overlaps
ehs:MentalFatigue at the edges and is still a gap, because neither factor
represents circadian phase. A gap alongside a close, broader or narrower match
would be a contradiction, and tests/test_crosswalk.py fails on one."""@en .

ehs:ContextDimension owl:disjointWith ehs:PerformanceInfluencingFactor .
ehs:ErrorMode        owl:disjointWith ehs:ControlLevel .


##############################################################################
# 3. Properties
##############################################################################

ehs:inDimension a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in dimension"@en ;
    rdfs:domain ehs:PerformanceInfluencingFactor ;
    rdfs:range ehs:ContextDimension .

ehs:correspondsToIdheasCategory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corresponds to IDHEAS-G category"@en ;
    rdfs:domain ehs:ContextDimension ;
    rdfs:range ehs:ExternalFactor ;
    ehs:sourceRef "nureg2198" .

ehs:localFactor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "local factor"@en ;
    rdfs:domain ehs:Alignment ;
    rdfs:range ehs:PerformanceInfluencingFactor .

ehs:externalFactor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "external factor"@en ;
    rdfs:domain ehs:Alignment ;
    rdfs:range ehs:ExternalFactor .

ehs:hasMatchStrength a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has match strength"@en ;
    rdfs:domain ehs:Alignment ;
    rdfs:range ehs:MatchStrength .

ehs:definedIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "defined in"@en ;
    rdfs:domain ehs:ExternalFactor ;
    rdfs:range ehs:ExternalFramework .

ehs:externalParent a owl:ObjectProperty ;
    rdfs:label "external parent"@en ;
    rdfs:domain ehs:ExternalFactor ;
    rdfs:range ehs:ExternalFactor ;
    rdfs:comment "Position of the external factor within its own framework's hierarchy, where that framework has one."@en .

ehs:degradationRaisesDemandOn a owl:ObjectProperty ;
    rdfs:label "degradation raises demand on"@en ;
    rdfs:domain ehs:PerformanceInfluencingFactor ;
    rdfs:range ehs:ControlLevel ;
    rdfs:comment """Theoretical claim taken from the cited source: degrading this factor pushes
performance toward the named control level. Not an empirically estimated effect."""@en .

ehs:predisposesTo a owl:ObjectProperty ;
    rdfs:label "predisposes to"@en ;
    rdfs:domain ehs:PerformanceInfluencingFactor ;
    rdfs:range ehs:ErrorMode ;
    rdfs:comment """Theoretical claim taken from the cited source. No effect size, no probability,
no empirical calibration is asserted or implied."""@en .

ehs:arisesAt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "arises at"@en ;
    rdfs:domain ehs:ErrorMode ;
    rdfs:range ehs:ControlLevel .

ehs:uncoveredFactor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "uncovered factor"@en ;
    rdfs:domain ehs:CoverageGap ;
    rdfs:range ehs:ExternalFactor .

ehs:ordinalRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ordinal rank"@en ;
    rdfs:domain ehs:FactorLevel ;
    rdfs:range xsd:integer ;
    rdfs:comment "Order only. Differences and ratios between ranks carry no meaning."@en .


##############################################################################
# 4. Match strengths (SKOS-flavoured, but deliberately NOT skos:exactMatch --
#    these are analyst judgements, not asserted identity)
##############################################################################

ehs:MatchExact   a owl:NamedIndividual , ehs:MatchStrength ; rdfs:label "exact"@en ;
    skos:definition "Same construct, same scope, wording effectively identical."@en .
ehs:MatchClose   a owl:NamedIndividual , ehs:MatchStrength ; rdfs:label "close"@en ;
    skos:definition "Same construct; wording or scope differs in ways unlikely to change an assessment."@en .
ehs:MatchBroader a owl:NamedIndividual , ehs:MatchStrength ; rdfs:label "broader"@en ;
    skos:definition "The external factor subsumes the local factor along with other content."@en .
ehs:MatchNarrower a owl:NamedIndividual , ehs:MatchStrength ; rdfs:label "narrower"@en ;
    skos:definition "The external factor covers only part of the local factor."@en .
ehs:MatchPartial a owl:NamedIndividual , ehs:MatchStrength ; rdfs:label "partial"@en ;
    skos:definition "Overlapping but non-nested constructs; the correspondence is interpretive."@en .

ehs:MatchExact ehs:sourceRef "groth2012" .
ehs:MatchPartial rdfs:comment "Groth and Mosleh (2012) report that PIFs across methods are not defined specifically enough for consistent interpretation. Rows marked partial are where that bites."@en .


##############################################################################
# 5. Factor levels (ordinal, five states)
##############################################################################

ehs:LevelEnhanced a owl:NamedIndividual , ehs:FactorLevel ;
    rdfs:label "enhanced"@en ; ehs:ordinalRank 2 ;
    skos:definition "Better than the nominal condition assumed by the base assessment."@en ;
    rdfs:comment "SPAR-H is one of the few methods that admits beneficial PSF influence; the level is retained here for that reason."@en ;
    ehs:sourceRef "gertman2005" .

ehs:LevelNominal a owl:NamedIndividual , ehs:FactorLevel ;
    rdfs:label "nominal"@en ; ehs:ordinalRank 1 ;
    skos:definition "The condition assumed by the base assessment; no adjustment warranted."@en .

ehs:LevelDegraded a owl:NamedIndividual , ehs:FactorLevel ;
    rdfs:label "degraded"@en ; ehs:ordinalRank 0 ;
    skos:definition "Worse than nominal in a way an analyst would record."@en .

ehs:LevelSeverelyDegraded a owl:NamedIndividual , ehs:FactorLevel ;
    rdfs:label "severely degraded"@en ; ehs:ordinalRank -1 ;
    skos:definition "Worse than nominal to a degree that would ordinarily stop or re-plan the task."@en .

ehs:LevelUnknown a owl:NamedIndividual , ehs:FactorLevel ;
    rdfs:label "unknown"@en ; ehs:ordinalRank -99 ;
    skos:definition "Not assessed. Distinct from nominal: an unassessed factor is not a satisfactory one."@en ;
    rdfs:comment "Kept separate on purpose. Treating missing data as nominal is the single most common way a screening tool understates a hazard."@en .


##############################################################################
# 6. Cognitive control levels and error modes (Rasmussen SRK / Reason GEMS)
##############################################################################

ehs:SkillBasedControl a owl:NamedIndividual , ehs:ControlLevel ;
    rdfs:label "skill-based control"@en ;
    skos:definition "Sensory-motor performance running automatically, without conscious control, once an intention is formed."@en ;
    ehs:sourceRef "rasmussen1983" .

ehs:RuleBasedControl a owl:NamedIndividual , ehs:ControlLevel ;
    rdfs:label "rule-based control"@en ;
    skos:definition "Performance governed by stored rules or procedures for a familiar situation."@en ;
    ehs:sourceRef "rasmussen1983" .

ehs:KnowledgeBasedControl a owl:NamedIndividual , ehs:ControlLevel ;
    rdfs:label "knowledge-based control"@en ;
    skos:definition "Performance in an unfamiliar situation for which no rule is available, requiring reasoning from a mental model of the system."@en ;
    ehs:sourceRef "rasmussen1983" .

ehs:SkillBasedSlipOrLapse a owl:NamedIndividual , ehs:ErrorMode ;
    rdfs:label "skill-based slip or lapse"@en ;
    ehs:arisesAt ehs:SkillBasedControl ;
    skos:definition "Execution failure of a correct intention: attentional slip or memory lapse."@en ;
    ehs:sourceRef "reason1990" .

ehs:RuleBasedMistake a owl:NamedIndividual , ehs:ErrorMode ;
    rdfs:label "rule-based mistake"@en ;
    ehs:arisesAt ehs:RuleBasedControl ;
    skos:definition "Correct execution of a wrong rule, or misapplication of a normally good rule."@en ;
    ehs:sourceRef "reason1990" .

ehs:KnowledgeBasedMistake a owl:NamedIndividual , ehs:ErrorMode ;
    rdfs:label "knowledge-based mistake"@en ;
    ehs:arisesAt ehs:KnowledgeBasedControl ;
    skos:definition "Failure of reasoning in a novel situation handled without an applicable rule."@en ;
    ehs:sourceRef "reason1990" .


##############################################################################
# 7. The four context dimensions
#
#    Each is bound to the IDHEAS-G category it renames. This binding is the
#    point: it is what stops the four dimensions being presented as new.
##############################################################################

ehs:TaskContext a owl:NamedIndividual , ehs:ContextDimension ;
    rdfs:label "Task context"@en ;
    skos:definition "Characteristics of the task being performed and of the information it requires."@en ;
    ehs:correspondsToIdheasCategory xw:idheas-Task ;
    ehs:sourceRef "nureg2198" ;
    rdfs:comment "Label identical to the IDHEAS-G category."@en .

ehs:OperationalContext a owl:NamedIndividual , ehs:ContextDimension ;
    rdfs:label "Operational context"@en ;
    skos:definition "Physical conditions of the place where the work occurs."@en ;
    ehs:correspondsToIdheasCategory xw:idheas-EnvironmentAndSituation ;
    ehs:sourceRef "nureg2198" ;
    rdfs:comment "Synonym for the IDHEAS-G category 'Environment and situation'. The rename buys familiarity for an occupational-safety audience and nothing else."@en .

ehs:HumanContext a owl:NamedIndividual , ehs:ContextDimension ;
    rdfs:label "Human context"@en ;
    skos:definition "Attributes of the people, teams and organisational processes performing the work."@en ;
    ehs:correspondsToIdheasCategory xw:idheas-Personnel ;
    ehs:sourceRef "nureg2198" ;
    rdfs:comment "Synonym for the IDHEAS-G category 'Personnel'."@en .

ehs:SystemContext a owl:NamedIndividual , ehs:ContextDimension ;
    rdfs:label "System context"@en ;
    skos:definition "Attributes of the plant, equipment, tools and interfaces the work is performed through."@en ;
    ehs:correspondsToIdheasCategory xw:idheas-System ;
    ehs:sourceRef "nureg2198" ;
    rdfs:comment "Label identical to the IDHEAS-G category."@en .


##############################################################################
# 8. The twenty factors
#
#    These are the twenty IDHEAS-G PIFs (NUREG-2198), adopted without addition,
#    deletion or subdivision. ehs:verbatimLabel carries the NRC's own wording as
#    transcribed from the report text; rdfs:label carries the wording used here.
#    Nothing in this section is original to this repository except the
#    ehs:observableProxy annotations, which are proposals and are unvalidated.
##############################################################################

### 8.1 Operational context (IDHEAS-G: environment and situation) -- five factors

ehs:WorkplaceAccessibilityAndHabitability a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Workplace accessibility and habitability"@en ;
    ehs:verbatimLabel "Accessibility/habitability of workplace including travel paths" ;
    ehs:inDimension ehs:OperationalContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Confined-space and hot-work permit records; access-route length recorded on the permit." .

ehs:WorkplaceVisibility a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Workplace visibility"@en ;
    ehs:verbatimLabel "Workplace visibility" ;
    ehs:inDimension ehs:OperationalContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Illuminance survey records; shift start time as a crude night-work indicator." .

ehs:NoiseAndCommunicationPathways a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Noise and communication pathways"@en ;
    ehs:verbatimLabel "Noise in workplace and communication pathways" ;
    ehs:inDimension ehs:OperationalContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Area noise dosimetry; hearing-conservation programme enrolment by work area." .

ehs:ThermalConditions a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Thermal conditions"@en ;
    ehs:verbatimLabel "Cold/heat/humidity" ;
    ehs:inDimension ehs:OperationalContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "WBGT readings or site weather records joined to the work order date and location." .

ehs:ResistanceToPhysicalMovement a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Resistance to physical movement"@en ;
    ehs:verbatimLabel "Resistance to physical movement" ;
    ehs:inDimension ehs:OperationalContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Required PPE ensemble recorded on the permit (encapsulating suit, SCBA, fall arrest)." .

### 8.2 System context (IDHEAS-G: system) -- three factors

ehs:SystemTransparency a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "System transparency to personnel"@en ;
    ehs:verbatimLabel "System and I&C transparency to personnel" ;
    ehs:inDimension ehs:SystemContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:KnowledgeBasedMistake ;
    ehs:observableProxy "Count of unlabelled or mislabelled equipment findings from field walkdowns." ;
    rdfs:comment "The link to knowledge-based mistakes is interpretive: an opaque system denies the operator the mental model that knowledge-based reasoning requires (Rasmussen 1983)."@en .

ehs:HumanSystemInterface a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Human-system interface"@en ;
    ehs:verbatimLabel "HSI" ;
    ehs:inDimension ehs:SystemContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:SkillBasedSlipOrLapse ;
    ehs:observableProxy "DCS alarm-rate statistics; count of standing alarms per operator per hour." .

ehs:EquipmentAndTools a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Equipment and tools"@en ;
    ehs:verbatimLabel "Equipment and tools" ;
    ehs:inDimension ehs:SystemContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "CMMS overdue preventive-maintenance backlog for the asset named on the work order." .

### 8.3 Human context (IDHEAS-G: personnel) -- five factors

ehs:Staffing a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Staffing"@en ;
    ehs:verbatimLabel "Staffing" ;
    ehs:inDimension ehs:HumanContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Roster headcount against the shift minimum-manning standard; vacancy rate." .

ehs:ProceduresGuidanceAndInstructions a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Procedures, guidance and instructions"@en ;
    ehs:verbatimLabel "Procedures, guidance, and instructions" ;
    ehs:inDimension ehs:HumanContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:RuleBasedMistake ;
    ehs:observableProxy "Document-control system: procedure revision age, overdue periodic review flag, open change requests." ;
    ehs:boundaryNote "IDHEAS-G files procedures under Personnel. Practitioners frequently file them under Task or System. The disagreement is recorded rather than resolved." .

ehs:Training a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Training"@en ;
    ehs:verbatimLabel "Training" ;
    ehs:inDimension ehs:HumanContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:RuleBasedMistake , ehs:KnowledgeBasedMistake ;
    ehs:observableProxy "LMS completion and recency for the qualification the task requires; months in role." .

ehs:TeamAndOrganizationFactors a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Team and organisation factors"@en ;
    ehs:verbatimLabel "Team and organization factors" ;
    ehs:inDimension ehs:HumanContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Crew composition stability; proportion of contractor to employee hours on the job." .

ehs:WorkProcesses a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Work processes"@en ;
    ehs:verbatimLabel "Work processes" ;
    ehs:inDimension ehs:HumanContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Permit-to-work audit findings; management-of-change records open at the time of the task." .

### 8.4 Task context (IDHEAS-G: task) -- seven factors

ehs:InformationAvailabilityAndReliability a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Information availability and reliability"@en ;
    ehs:verbatimLabel "Information availability and reliability" ;
    ehs:inDimension ehs:TaskContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:RuleBasedMistake , ehs:KnowledgeBasedMistake ;
    ehs:observableProxy "Instrument out-of-service list; count of failed or bypassed transmitters on the unit." .

ehs:ScenarioFamiliarity a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Scenario familiarity"@en ;
    ehs:verbatimLabel "Scenario familiarity" ;
    ehs:inDimension ehs:TaskContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:degradationRaisesDemandOn ehs:KnowledgeBasedControl ;
    ehs:predisposesTo ehs:KnowledgeBasedMistake ;
    ehs:observableProxy "Work-order type (routine PM against corrective or first-of-a-kind); count of prior executions of the same procedure at the site." ;
    rdfs:comment "The demand claim is Rasmussen's: an unfamiliar situation for which no rule is stored must be handled at the knowledge-based level."@en .

ehs:MultitaskingInterruptionsAndDistractions a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Multitasking, interruptions and distractions"@en ;
    ehs:verbatimLabel "Multitasking, interruptions, and distractions" ;
    ehs:inDimension ehs:TaskContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:SkillBasedSlipOrLapse ;
    ehs:observableProxy "Concurrent open permits per supervisor; radio or phone traffic volume during the task window." .

ehs:TaskComplexity a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Task complexity"@en ;
    ehs:verbatimLabel "Task complexity" ;
    ehs:inDimension ehs:TaskContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:degradationRaisesDemandOn ehs:KnowledgeBasedControl ;
    ehs:observableProxy "Procedure step count; number of distinct systems or crafts named on the permit." ;
    rdfs:comment "Interpretive. SPAR-H treats complexity as difficulty of performance; the step from difficulty to knowledge-based demand is this ontology's reading, not a finding."@en .

ehs:MentalFatigue a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Mental fatigue"@en ;
    ehs:verbatimLabel "Mental fatigue" ;
    ehs:inDimension ehs:TaskContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:SkillBasedSlipOrLapse ;
    ehs:observableProxy "Hours elapsed since shift start; consecutive shifts worked; overtime hours in the trailing 7 days." ;
    ehs:boundaryNote "IDHEAS-G files mental fatigue under Task. An occupational-safety practitioner would ordinarily file it under Human or Operational. The disagreement is recorded rather than resolved." ;
    rdfs:comment "Time-on-shift is the natural proxy here, and it is also where this ontology's claims stop: hour-of-shift injury counts are not risk rates without an exposure denominator (Hanecke et al. 1998; Folkard and Tucker 2003)."@en .

ehs:TimePressureAndStress a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Time pressure and stress"@en ;
    ehs:verbatimLabel "Time pressure and stress" ;
    ehs:inDimension ehs:TaskContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:predisposesTo ehs:KnowledgeBasedMistake ;
    ehs:observableProxy "Scheduled against actual outage duration; work orders flagged as expedited or emergency." ;
    ehs:boundaryNote "IDHEAS-G files time pressure and stress under Task. SPAR-H splits the same content across two separate PSFs (available time; stress and stressors)." .

ehs:PhysicalDemands a owl:NamedIndividual , ehs:PerformanceInfluencingFactor ;
    rdfs:label "Physical demands"@en ;
    ehs:verbatimLabel "Physical demands" ;
    ehs:inDimension ehs:TaskContext ;
    ehs:sourceRef "nureg2198" ;
    ehs:observableProxy "Manual-handling assessment on the job safety analysis; required lift weight recorded on the work order." .


##############################################################################
# 9. External frameworks
##############################################################################

xw:fw-IDHEAS-G a owl:NamedIndividual , ehs:ExternalFramework ;
    rdfs:label "IDHEAS-G"@en ;
    dcterms:bibliographicCitation "U.S. Nuclear Regulatory Commission (2021). The General Methodology of an Integrated Human Event Analysis System (IDHEAS-G). NUREG-2198." ;
    ehs:sourceRef "nureg2198" .

xw:fw-SPARH a owl:NamedIndividual , ehs:ExternalFramework ;
    rdfs:label "SPAR-H"@en ;
    dcterms:bibliographicCitation "Gertman, D.I., Blackman, H.S., Marble, J.L., Byers, J.C. & Smith, C.L. (2005). The SPAR-H Human Reliability Analysis Method. NUREG/CR-6883, INL/EXT-05-00509." ;
    ehs:sourceRef "gertman2005" .

xw:fw-CREAM a owl:NamedIndividual , ehs:ExternalFramework ;
    rdfs:label "CREAM"@en ;
    dcterms:bibliographicCitation "Hollnagel, E. (1998). Cognitive Reliability and Error Analysis Method (CREAM). Oxford: Elsevier Science." ;
    ehs:sourceRef "hollnagel1998" ;
    rdfs:comment "The nine CPC labels used here were transcribed from an open-access secondary source (Shirali et al. 2019, MethodsX) because the book text was not consulted directly. See ../docs/PROVENANCE.md."@en .

xw:fw-HFACS a owl:NamedIndividual , ehs:ExternalFramework ;
    rdfs:label "HFACS"@en ;
    dcterms:bibliographicCitation "Shappell, S.A. & Wiegmann, D.A. (2000). The Human Factors Analysis and Classification System--HFACS. DOT/FAA/AM-00/7. Revised taxonomy as figured in Shappell et al. (2006), DOT/FAA/AM-06/18." ;
    ehs:sourceRef "shappell2000" , "shappell2006" ;
    rdfs:comment "Two versions matter here. The 2000 report subdivides Preconditions into Substandard Conditions and Substandard Practices of Operators. The revised taxonomy figured in the 2006 report uses Environmental Factors, Condition of Operators and Personnel Factors. The crosswalk maps to the revised taxonomy and says so."@en .

xw:fw-HSE-PIF a owl:NamedIndividual , ehs:ExternalFramework ;
    rdfs:label "HSE Performance Influencing Factors"@en ;
    dcterms:bibliographicCitation "Health and Safety Executive. Performance Influencing Factors (PIFs). HSE human factors guidance, https://www.hse.gov.uk/humanfactors/assets/docs/pifs.pdf" ;
    ehs:sourceRef "hse_pifs" ;
    rdfs:comment "HSE states of its own list: 'NB. This list is not exhaustive'."@en .


