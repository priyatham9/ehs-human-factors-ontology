##############################################################################
# 11. Additional properties used by the crosswalk
##############################################################################

ehs:noCounterpartIn a owl:ObjectProperty ;
    rdfs:label "no counterpart in"@en ;
    rdfs:domain ehs:PerformanceInfluencingFactor ;
    rdfs:range ehs:ExternalFramework ;
    rdfs:comment "Asserts that the named framework has no factor corresponding to this one. A negative claim, recorded so that it can be argued with."@en .

ehs:outOfScopeNote a owl:AnnotationProperty ;
    rdfs:label "out of scope note"@en ;
    rdfs:comment "Marks an external factor deliberately not crosswalked, with the reason."@en .

xw:hfacs-UnsafeActs ehs:outOfScopeNote "Unsafe acts are outcomes, not context. Modelled here as error modes (section 6), not as performance-influencing factors." .
xw:hfacs-Errors ehs:outOfScopeNote "Outcome category, not context." .
xw:hfacs-DecisionErrors ehs:outOfScopeNote "Corresponds to the mistake classes in section 6, not to a factor." .
xw:hfacs-SkillBasedErrors ehs:outOfScopeNote "Corresponds to ehs:SkillBasedSlipOrLapse, not to a factor." .
xw:hfacs-PerceptualErrors ehs:outOfScopeNote "Outcome category, not context." .
xw:hfacs-Violations ehs:outOfScopeNote "Violations are intentional deviations and are outside the error taxonomy this ontology encodes." .
xw:hfacs-RoutineViolations ehs:outOfScopeNote "See parent." .
xw:hfacs-ExceptionalViolations ehs:outOfScopeNote "See parent." .
xw:hfacs-Preconditions ehs:outOfScopeNote "Structural container; its children are crosswalked individually." .
xw:hfacs-EnvironmentalFactors ehs:outOfScopeNote "Structural container; its children are crosswalked individually." .
xw:hfacs-ConditionOfOperators ehs:outOfScopeNote "Structural container; its children are crosswalked individually." .
xw:hfacs-PersonnelFactors ehs:outOfScopeNote "Structural container; its children are crosswalked individually." .
xw:hfacs-UnsafeSupervision ehs:outOfScopeNote "Structural container; its children are crosswalked individually." .
xw:hfacs-OrganizationalInfluences ehs:outOfScopeNote "Structural container; its children are crosswalked individually." .
xw:hse-JobFactors ehs:outOfScopeNote "Heading, not a factor." .
xw:hse-PersonFactors ehs:outOfScopeNote "Heading, not a factor." .
xw:hse-OrganisationFactors ehs:outOfScopeNote "Heading, not a factor." .
xw:idheas-EnvironmentAndSituation ehs:outOfScopeNote "Bound to a context dimension by ehs:correspondsToIdheasCategory, not by a factor-level alignment." .
xw:idheas-System ehs:outOfScopeNote "Bound to a context dimension by ehs:correspondsToIdheasCategory." .
xw:idheas-Personnel ehs:outOfScopeNote "Bound to a context dimension by ehs:correspondsToIdheasCategory." .
xw:idheas-Task ehs:outOfScopeNote "Bound to a context dimension by ehs:correspondsToIdheasCategory." .


