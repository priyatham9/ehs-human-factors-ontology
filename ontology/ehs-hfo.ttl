xw:al-Phys-hfacs2 a owl:NamedIndividual , ehs:Alignment ; ehs:localFactor ehs:PhysicalDemands ; ehs:externalFactor xw:hfacs-AdversePhysiologicalStates ; ehs:hasMatchStrength ehs:MatchPartial ; ehs:sourceRef "shappell2000" .
