xw:al-Phys-hse2 a owl:NamedIndividual , ehs:Alignment ; ehs:localFactor ehs:PhysicalDemands ; ehs:externalFactor xw:hse-WorkOverloadUnderload ; ehs:hasMatchStrength ehs:MatchPartial ; ehs:sourceRef "hse_pifs" .


##############################################################################
# 13. Coverage gaps
#
#    External factors this ontology does not cover, or covers only at partial
#    strength. Asserted rather than left implicit, because a crosswalk that only
#    records its successes is a sales document.
##############################################################################

xw:gap-cream-TimeOfDay a owl:NamedIndividual , ehs:CoverageGap ;
    ehs:uncoveredFactor xw:cream-TimeOfDay ;
    rdfs:comment """No local factor represents time of day or circadian phase. IDHEAS-G has no such
PIF either, so the gap is inherited rather than introduced. This is the gap that
matters most for shift-based occupational settings, and closing it would require
an exposure denominator by hour of shift that no public dataset currently
supplies (Hanecke et al. 1998; Folkard and Tucker 2003)."""@en ;
    ehs:sourceRef "hollnagel1998" , "folkard2003" , "hanecke1998" .

xw:gap-hfacs-PersonalReadiness a owl:NamedIndividual , ehs:CoverageGap ;
    ehs:uncoveredFactor xw:hfacs-PersonalReadiness ;
    rdfs:comment """No local factor represents personal readiness in the HFACS sense: an
individual's off-duty preparation for work, including rest, diet and compliance
with alcohol and self-medication rules. The gap is inherited rather than
introduced. IDHEAS-G has no fitness-for-duty PIF, whereas SPAR-H does, and the
twenty factors here are IDHEAS-G's twenty adopted unchanged. ehs:MentalFatigue
is the nearest local factor and is deliberately not aligned to this one: fatigue
is a state during the task, personal readiness is conduct before it, and one
causes the other rather than being it."""@en ;
    ehs:sourceRef "shappell2000" , "shappell2006" , "nureg2198" , "gertman2005" .

xw:gap-hse-Motivation a owl:NamedIndividual , ehs:CoverageGap ;
    ehs:uncoveredFactor xw:hse-Motivation ;
    rdfs:comment "No local factor represents motivation or competing priorities as an attribute of the individual."@en ;
    ehs:sourceRef "hse_pifs" .

xw:gap-hse-PeerPressure a owl:NamedIndividual , ehs:CoverageGap ;
    ehs:uncoveredFactor xw:hse-PeerPressure ;
    rdfs:comment "No local factor represents peer pressure. Team and organisation factors is too coarse to stand in for it."@en ;
    ehs:sourceRef "hse_pifs" .

xw:gap-hse-OrganisationalLearning a owl:NamedIndividual , ehs:CoverageGap ;
    ehs:uncoveredFactor xw:hse-OrganisationalLearning ;
    rdfs:comment "No local factor represents the effectiveness of organisational learning."@en ;
    ehs:sourceRef "hse_pifs" .

xw:gap-hfacs-FailedToCorrectProblem a owl:NamedIndividual , ehs:CoverageGap ;
    ehs:uncoveredFactor xw:hfacs-FailedToCorrectProblem ;
    rdfs:comment "No local factor represents a supervisor's failure to correct a known deficiency."@en ;
    ehs:sourceRef "shappell2000" .

xw:gap-hfacs-SupervisoryViolations a owl:NamedIndividual , ehs:CoverageGap ;
    ehs:uncoveredFactor xw:hfacs-SupervisoryViolations ;
    rdfs:comment "No local factor represents wilful supervisory disregard of rules."@en ;
    ehs:sourceRef "shappell2000" .

